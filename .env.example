# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (MongoDB Atlas URI or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourcluster.mongodb.net/interview-coach?retryWrites=true&w=majority

# Email Service (Required for OTP Account Verification & Password Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

